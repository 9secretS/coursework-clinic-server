# Параметры серверной части (читаются AppConfig.fromEnv)
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/clinic
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Путь к service account Firebase. Если не задан - демонстрационный режим.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/firebase-service-account.json
